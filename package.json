{
  "name": "zod-nest",
  "version": "3.8.0",
  "description": "Modern Zod v4-only NestJS + OpenAPI 3.1 integration. Successor to nestjs-zod.",
  "license": "MIT",
  "author": "Rodrigo Azevedo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigowbazevedo/zod-nest.git"
  },
  "bugs": {
    "url": "https://github.com/rodrigowbazevedo/zod-nest/issues"
  },
  "homepage": "https://github.com/rodrigowbazevedo/zod-nest#readme",
  "keywords": [
    "nestjs",
    "zod",
    "openapi",
    "swagger",
    "validation",
    "dto",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.mjs",
      "require": "./dist/helpers/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.mjs",
      "require": "./dist/express/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "import": "./dist/fastify/index.mjs",
      "require": "./dist/fastify/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "helpers": [
        "dist/helpers/index.d.ts"
      ],
      "express": [
        "dist/express/index.d.ts"
      ],
      "fastify": [
        "dist/fastify/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "release": "semantic-release",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.1 <13.0.0",
    "@nestjs/core": ">=11.0.1 <13.0.0",
    "@nestjs/swagger": ">=11.0.0 <13.0.0",
    "reflect-metadata": ">=0.2.0 <0.3.0",
    "rxjs": ">=7.6.0 <8.0.0",
    "zod": ">=4.4.0 <5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@swc/core": "^1.16.18",
    "@types/multer": "2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^78.0.0",
    "expect-type": "^1.4.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4",
    "zod": "^4.5.4"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0"
  },
  "overrides": {
    "@commitlint/read": "21.0.1"
  }
}
